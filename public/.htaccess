<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect a legacy percent-encoded Sobolev URL to the normalized ASCII slug.
    RewriteCond %{THE_REQUEST} \s/+andrej-sobolev-pereizdal-svoi-luchshie-pesni-albom-(?:%E2%84%961|№1)(?:[\s?]|$) [NC]
    RewriteRule ^andrej-sobolev-pereizdal-svoi-luchshie-pesni-albom-(?:%E2%84%961|№1)$ https://notame.ru/andrej-sobolev-pereizdal-svoi-luchshie-pesni-albom-1 [R=301,L,NE]

    # Redirect trailing slashes on non-directory URLs straight to the final HTTPS canonical.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^ https://notame.ru%1 [R=301,L,NE]

    # Redirect www to non-www on the HTTPS canonical host.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
